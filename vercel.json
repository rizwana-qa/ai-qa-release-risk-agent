{
  "version": 2,
  "builds": [
    { "src": "api/vercel/health.ts", "use": "@vercel/node" },
    { "src": "api/vercel/meta.ts", "use": "@vercel/node" },
    { "src": "api/vercel/scenarios.ts", "use": "@vercel/node" },
    { "src": "api/vercel/scenario.ts", "use": "@vercel/node" },
    { "src": "api/vercel/assess.ts", "use": "@vercel/node" },
    { "src": "api/vercel/assess-custom.ts", "use": "@vercel/node" },
    { "src": "web/index.html", "use": "@vercel/static" },
    { "src": "web/styles.css", "use": "@vercel/static" },
    { "src": "web/app.js", "use": "@vercel/static" },
    { "src": "web/workspace.js", "use": "@vercel/static" },
    { "src": "web/components.js", "use": "@vercel/static" },
    { "src": "web/format.js", "use": "@vercel/static" },
    { "src": "web/icons.js", "use": "@vercel/static" },
    { "src": "web/upload.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/health$", "dest": "/api/vercel/health.ts" },
    { "src": "^/api/meta$", "dest": "/api/vercel/meta.ts" },
    { "src": "^/api/scenarios$", "dest": "/api/vercel/scenarios.ts" },
    { "src": "^/api/scenario$", "dest": "/api/vercel/scenario.ts" },
    { "src": "^/api/assess/custom$", "dest": "/api/vercel/assess-custom.ts" },
    { "src": "^/api/assess$", "dest": "/api/vercel/assess.ts" },
    { "src": "^/$", "dest": "/web/index.html" },
    { "src": "^/(.*)$", "dest": "/web/$1" }
  ]
}
