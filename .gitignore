# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment / secrets (never commit)
.env
.env.*
*.local

# Pipeline / n8n run state (regenerated per run)
.pipeline-run/

# Playwright (browser end-to-end tests)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Recorded demo video — binary asset, delivered as a separate LinkedIn upload.
# The demo TEST (tests/e2e/linkedin-demo.spec.ts) and its config ARE committed.
artifacts/

# Presentation exports — regenerated from presentation/*.md with marp-cli.
# The deck SOURCE (presentation/*.md) and README ARE committed.
presentation/*.pptx
presentation/*.pdf
presentation/*.html

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Claude Code session settings
.claude/
